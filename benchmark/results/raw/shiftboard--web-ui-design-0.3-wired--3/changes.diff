diff --git a/src/lib/dates.ts b/src/lib/dates.ts
index 602941c..8198d80 100644
--- a/src/lib/dates.ts
+++ b/src/lib/dates.ts
@@ -31,3 +31,16 @@ export function shiftHours(start: string, end: string): number {
   if (endMinutes <= startMinutes) endMinutes += 24 * 60;
   return (endMinutes - startMinutes) / 60;
 }
+
+export function parseDate(value: string): Date {
+  const [year, month, day] = value.split('-').map(Number);
+  return new Date(year, month - 1, day);
+}
+
+export function countDays(start: string, end: string): number {
+  return Math.round((parseDate(end).getTime() - parseDate(start).getTime()) / 86_400_000) + 1;
+}
+
+export function formatDateRange(start: string, end: string): string {
+  return start === end ? formatDay(parseDate(start)) : `${formatDay(parseDate(start))} to ${formatDay(parseDate(end))}`;
+}
