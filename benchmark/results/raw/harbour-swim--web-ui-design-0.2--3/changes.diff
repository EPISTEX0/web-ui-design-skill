+  .nav a.nav-join { margin: var(--s2) 0 0; justify-content: center; }
+  .header-inner { row-gap: 0; }
+}
+
+/* notices */
+.notices { background: #fdf3cd; border-bottom: 1px solid #ecd68a; color: #4a3b00; }
+.notices ul {
+  max-width: var(--page); margin: 0 auto; padding: var(--s2) var(--gutter);
+  list-style: none; display: flex; flex-wrap: wrap; gap: var(--s1) var(--s6);
+  font-size: 0.875rem; line-height: 1.4;
+}
+.notices li { padding-left: var(--s4); position: relative; }
+.notices li::before { content: ""; position: absolute; left: 0; top: 0.5em; width: 6px; height: 6px; border-radius: 50%; background: #a67c00; }
+
+/* page frame */
+main, .footer-inner { max-width: var(--page); margin: 0 auto; }
+main { background: var(--surface); }
+.section { padding: var(--s10) var(--gutter); }
+.section + .section { border-top: 1px solid var(--border); }
+
+/* hero */
+.hero { position: relative; background: var(--navy-800); }
+.hero img { width: 100%; aspect-ratio: 940 / 320; object-fit: cover; min-height: 180px; }
+.hero-text { padding: var(--s6) var(--gutter) var(--s8); border-top: 4px solid var(--accent); }
+.hero-text h1 { font-size: 2rem; color: var(--yellow-400); letter-spacing: -0.02em; }
+.hero-text p { color: #fff; margin: var(--s2) 0 var(--s5); font-size: 1.125rem; }
+
+@media (min-width: 760px) {
+  .hero-text {
+    position: absolute; left: var(--s8); bottom: var(--s8);
+    border-top: 0; border-left: 5px solid var(--accent);
+    padding: var(--s4) var(--s6); max-width: 440px;
+    background: var(--navy-800);
+  }
+  .hero-text h1 { font-size: 2.5rem; }
+}
+
+/* welcome */
+.welcome { display: grid; gap: var(--s5); align-items: center; }
+.welcome img { width: 100%; max-width: 280px; height: auto; border-radius: var(--r-lg); box-shadow: 0 0 0 1px rgba(0,0,0,0.1); }
+@media (min-width: 760px) {
+  .welcome { grid-template-columns: 220px 1fr; gap: var(--s8); align-items: start; }
+  .welcome img { max-width: none; }
+}
+
+/* timetable */
+.day-tabs { display: flex; flex-wrap: wrap; gap: var(--s2); margin-bottom: var(--s5); }
+.day-tabs[hidden] { display: none; }
+.day-tabs button {
+  min-height: 44px; min-width: 52px; padding: 0 var(--s4);
+  font: inherit; font-weight: 600; color: var(--navy-800);
+  background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-md);
+  cursor: pointer;
+  transition: background-color var(--t-hover) var(--ease-out), transform var(--t-press) var(--ease-out);
+}
+.day-tabs button:active { transform: scale(0.97); }
+@media (hover: hover) { .day-tabs button:hover { background: var(--bg); } }
+.day-tabs button[aria-pressed="true"] { background: var(--navy-800); border-color: var(--navy-800); color: #fff; }
+.day-tabs .today-dot { font-weight: 400; font-size: 0.75rem; margin-left: var(--s1); }
+
+.timetable { width: 100%; border-collapse: collapse; font-size: 0.9375rem; font-variant-numeric: tabular-nums; }
+.timetable th {
+  background: var(--navy-800); color: #fff; text-align: left;
+  padding: var(--s3) var(--s3); font-weight: 600;
+}
+.timetable td { padding: var(--s3); border-bottom: 1px solid var(--border); color: var(--text); }
+.timetable tbody tr:nth-child(even) td { background: #f6f9fb; }
+.timetable td[data-label="Session"] { font-weight: 600; color: var(--navy-800); }
+.timetable tr[hidden] { display: none; }
+.note { margin-top: var(--s4); font-size: 0.875rem; color: var(--text-muted); }
+
+@media (max-width: 759px) {
+  .timetable, .timetable tbody { display: block; }
+  .timetable thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
+  .timetable tr {
+    display: grid; grid-template-columns: 1fr auto; gap: 0 var(--s3);
+    padding: var(--s3) var(--s4); margin-bottom: var(--s2);
+    border: 1px solid var(--border); border-left: 4px solid var(--navy-800); border-radius: var(--r-md);
+    background: var(--surface);
+  }
+  .timetable tr[hidden] { display: none; }
+  .timetable td, .timetable tbody tr:nth-child(even) td { display: block; padding: 0; border: 0; background: none; font-size: 0.9375rem; }
+  .timetable td[data-label="Session"] { grid-column: 1; grid-row: 2; font-size: 1.0625rem; }
+  .timetable td[data-label="Time"] { grid-column: 1; grid-row: 1; font-weight: 700; color: var(--pool-700); }
+  .timetable td[data-label="Day"] { grid-column: 2; grid-row: 1; text-align: right; font-size: 0.8125rem; color: var(--text-muted); }
+  .timetable td[data-label="Coach"] { grid-column: 2; grid-row: 2; text-align: right; }
+  .timetable td[data-label="Lane"], .timetable td[data-label="Level"] { grid-column: 1 / -1; grid-row: 3; font-size: 0.875rem; color: var(--text-secondary); }
+  .timetable td[data-label="Lane"] { display: inline; }
+  .timetable td[data-label="Lane"]::before { content: "Lane "; }
+  .timetable td[data-label="Coach"]::before { content: "Coach "; color: var(--text-muted); font-size: 0.8125rem; }
+  .timetable td[data-label="Level"] { margin-top: -2px; }
+  /* lane and level share one line */
+  .timetable td[data-label="Lane"] { grid-column: 1 / 2; }
+  .timetable td[data-label="Level"] { grid-column: 1 / 2; grid-row: 4; }
+}
+
+/* membership */
+.plans { display: grid; gap: var(--s4); grid-template-columns: 1fr; }
+@media (min-width: 560px) { .plans { grid-template-columns: repeat(2, 1fr); } }
+@media (min-width: 900px) { .plans { grid-template-columns: repeat(4, 1fr); } }
+.plan {
+  padding: var(--s5); background: var(--surface);
+  border: 1px solid var(--border); border-top: 4px solid var(--navy-800); border-radius: var(--r-md);
+}
+.plan p:last-child { margin-bottom: 0; }
+.price { font-size: 1.75rem; font-weight: 800; color: var(--navy-800); letter-spacing: -0.02em; margin-bottom: var(--s2); }
+.price span { font-size: 0.875rem; font-weight: 400; color: var(--text-muted); letter-spacing: 0; }
+
+/* join form */
+.join { display: grid; gap: var(--s8); }
+@media (min-width: 860px) { .join { grid-template-columns: 1fr 340px; } }
+.field { margin-bottom: var(--s4); max-width: 420px; }
+.field label { display: block; font-weight: 600; color: var(--navy-800); margin-bottom: var(--s1); }
+input[type="text"], input[type="email"], input[type="tel"], select {
+  display: block; width: 100%; min-height: 48px;
+  font: inherit; font-size: 1rem; color: var(--text);
+  padding: var(--s2) var(--s3);
+  background: var(--surface); border: 1px solid #8795a8; border-radius: var(--r-md);
+}
+input:focus-visible, select:focus-visible { outline: 3px solid var(--pool-700); outline-offset: 1px; border-color: var(--pool-700); }
+.field.invalid input, .field.invalid select { border-color: var(--danger); border-width: 2px; }
+.field label.check { display: flex; gap: var(--s3); align-items: flex-start; font-weight: 400; color: var(--text-secondary); }
+.check input { flex: none; width: 24px; height: 24px; margin-top: 2px; accent-color: var(--navy-800); }
+.error { display: none; color: var(--danger); font-size: 0.9375rem; margin: var(--s1) 0 0; }
+.field.invalid .error { display: block; }
+.join-box .btn { width: 100%; max-width: 420px; }
+.join-aside img { width: 100%; border-radius: var(--r-lg); box-shadow: 0 0 0 1px rgba(0,0,0,0.1); margin-bottom: var(--s3); }
+.thanks { font-size: 1.25rem; color: var(--navy-800); margin: var(--s5) 0; font-weight: 600; }
 
