diff --git a/src/lib/dates.ts b/src/lib/dates.ts
index 602941c..0f66f99 100644
--- a/src/lib/dates.ts
+++ b/src/lib/dates.ts
@@ -31,3 +31,23 @@ export function shiftHours(start: string, end: string): number {
   if (endMinutes <= startMinutes) endMinutes += 24 * 60;
   return (endMinutes - startMinutes) / 60;
 }
+
+function parseIsoDate(value: string): Date {
+  const [year, month, day] = value.split('-').map(Number);
+  return new Date(year, month - 1, day);
+}
+
+export function formatIsoRange(start: string, end: string): string {
+  const from = parseIsoDate(start);
+  if (start === end) return `${weekdayFormat.format(from)} ${formatDay(from)}`;
+  return `${formatDay(from)} to ${formatDay(parseIsoDate(end))}`;
+}
+
+export function countIsoDays(start: string, end: string): number {
+  const span = parseIsoDate(end).getTime() - parseIsoDate(start).getTime();
+  return Math.round(span / (24 * 60 * 60 * 1000)) + 1;
+}
+
+export function formatIsoDay(value: string): string {
+  return formatDay(new Date(value));
+}
