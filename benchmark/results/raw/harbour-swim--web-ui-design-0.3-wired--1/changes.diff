+.field { margin-bottom: var(--s4); }
+.field label:not(.check) { display: block; font-weight: 600; margin-bottom: var(--s1); }
+input[type="text"], input[type="email"], input[type="tel"], select {
+  display: block;
+  width: 100%;
+  max-width: 420px;
+  min-height: 48px;
+  padding: var(--s2) var(--s3);
+  font: inherit;
+  color: var(--ink);
+  background: var(--surface);
+  border: 2px solid var(--control);
+  border-radius: var(--r-sm);
+}
+input:focus-visible, select:focus-visible { outline-offset: 1px; border-color: var(--navy); }
+.check { display: flex; gap: var(--s3); align-items: flex-start; min-height: 44px; cursor: pointer; }
+.check input { flex: none; width: 24px; height: 24px; margin: var(--s2) 0 0; accent-color: var(--navy); }
+.field.invalid input, .field.invalid select { border-color: var(--error); }
+.error { margin: var(--s1) 0 0; color: var(--error); font-weight: 600; font-size: 0.9375rem; }
+.error::before { content: "Error: "; }
+.thanks { font-size: 1.25rem; font-weight: 700; margin: var(--s4) 0; }
+
+/* ---------- news ---------- */
+.news-list {
+  background: var(--surface);
+  border-radius: var(--r-lg);
+  box-shadow: var(--ring);
+  padding: var(--s2) var(--s5);
+}
+.news-list .item { padding: var(--s5) 0; border-bottom: 1px solid var(--line); }
+.news-list .item:last-child { border-bottom: 0; }
+.news-list p:last-child { margin-bottom: 0; }
+.date { font-size: 0.9375rem; color: var(--ink-3); margin-bottom: var(--s1); }
+
+/* ---------- footer ---------- */
+.site-footer {
+  margin-top: var(--s16);
+  padding: var(--s10) 0 calc(var(--s8) + env(safe-area-inset-bottom));
+  background: var(--navy);
+  color: #e3e9f2;
+}
+.site-footer h2 { color: var(--yellow); }
+.site-footer h2::after { --line: #3b4c70; }
+.site-footer a { color: var(--yellow); }
+.contact-grid { display: grid; gap: var(--s4) var(--s10); }
+.site-footer address { font-style: normal; margin-bottom: var(--s4); }
+.site-footer p { max-width: none; }
+#copy { margin: var(--s8) 0 0; padding-top: var(--s4); border-top: 1px solid #3b4c70; font-size: 0.9375rem; color: #b8c3d6; }
+
+/* ---------- wider screens ---------- */
+@media (min-width: 760px) {
+  .section { padding-block: var(--s16) 0; }
+  h2 { font-size: 2.25rem; }
+  .container { padding-inline: var(--s8); }
+  .header-bar { grid-template-columns: auto 1fr auto; padding-block: var(--s3); }
+  .logo img { width: 208px; }
+  .logo { grid-column: 1; grid-row: 1; }
+  .main-nav { grid-column: 2; grid-row: 1; margin: 0; justify-self: end; }
+  .header-join { grid-column: 3; grid-row: 1; }
+  .main-nav ul { padding: 0; overflow: visible; }
+  .site-header { position: sticky; top: 0; }
+  .hero { padding-top: var(--s6); }
+  .hero-img { aspect-ratio: 16 / 7; object-position: 50% 60%; }
+  .hero-copy { padding: var(--s8); }
+  .hero-copy h1 { font-size: 2.5rem; }
+  .actions .btn { flex: 0 1 auto; }
+  .welcome-grid { grid-template-columns: 300px 1fr; gap: var(--s10); }
+  .plans { grid-template-columns: repeat(2, 1fr); }
+  .join-card { grid-template-columns: 1fr 320px; padding: var(--s10); }
+  .contact-grid { grid-template-columns: 1fr 1fr; }
+}
+@media (min-width: 1000px) {
+  .hero-frame { position: relative; }
+  .hero-img { aspect-ratio: 940 / 320; object-position: 50% 50%; }
+  .hero-copy {
+    position: absolute;
+    left: var(--s8);
+    bottom: var(--s8);
+    max-width: 440px;
+    padding: var(--s6);
+    background: var(--navy);
+    border-radius: var(--r-md);
+    border-left: 6px solid var(--yellow);
+  }
+}
+@media (min-width: 1040px) {
+  .plans { grid-template-columns: repeat(4, 1fr); }
 }
-#contact h2 { color: #f2c230; border-bottom: 1px solid #3b4c70; }
-#contact .col { float: left; width: 400px; margin-right: 20px; }
-#contact p { margin-bottom: 10px; }
-#copy { font-size: 11px; color: #8d98ae; border-top: 1px solid #3b4c70; padding-top: 8px; margin-top: 6px; }
