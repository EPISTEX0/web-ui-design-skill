diff --git a/src/pages/TimeOff.tsx b/src/pages/TimeOff.tsx
new file mode 100644
index 0000000..0194eb5
--- /dev/null
+++ b/src/pages/TimeOff.tsx
@@ -0,0 +1,239 @@
+import { useEffect, useMemo, useState } from 'react';
+import type { FormEvent } from 'react';
+import { Badge, Button, Card, EmptyState, Modal, PageHeader, Select, Skeleton, Table, TableBody, TableCell, TableHead, TableHeaderCell, TableRow, Textarea } from '../components';
+import type { BadgeTone } from '../components';
+import { approveRequest, declineRequest, getTimeOffRequests } from '../api/timeOff';
+import type { TimeOffRequest, TimeOffStatus, TimeOffType } from '../api/timeOff';
+import { staff } from '../data/staff';
+import { formatDay } from '../lib/dates';
+import styles from './TimeOff.module.css';
+
+const ALL = 'all';
+
+const statusOptions = [
+  { value: 'pending', label: 'Pending' },
+  { value: 'approved', label: 'Approved' },
+  { value: 'declined', label: 'Declined' },
+  { value: ALL, label: 'All statuses' },
+];
+
+const typeOptions = [
+  { value: ALL, label: 'All types' },
+  { value: 'vacation', label: 'Vacation' },
+  { value: 'sick', label: 'Sick' },
+  { value: 'personal', label: 'Personal' },
+];
+
+const typeLabels: Record<TimeOffType, string> = { vacation: 'Vacation', sick: 'Sick', personal: 'Personal' };
+const statusTones: Record<TimeOffStatus, BadgeTone> = { pending: 'warning', approved: 'success', declined: 'danger' };
+
+function parseDay(value: string): Date {
+  const [year, month, day] = value.split('-').map(Number);
+  return new Date(year, month - 1, day);
+}
+
+function formatRange(request: TimeOffRequest): string {
+  const start = parseDay(request.start);
+  const end = parseDay(request.end);
+  const startLabel = `${formatDay(start)}${start.getFullYear() !== end.getFullYear() ? ` ${start.getFullYear()}` : ''}`;
+  if (request.start === request.end) return `${startLabel} ${start.getFullYear()}`;
+  return `${startLabel} to ${formatDay(end)} ${end.getFullYear()}`;
+}
+
+function countDays(request: TimeOffRequest): number {
+  return Math.round((parseDay(request.end).getTime() - parseDay(request.start).getTime()) / 86_400_000) + 1;
+}
+
+export function TimeOff() {
+  const [requests, setRequests] = useState<TimeOffRequest[] | null>(null);
+  const [loadError, setLoadError] = useState<string | null>(null);
+  const [status, setStatus] = useState<string>('pending');
+  const [type, setType] = useState<string>(ALL);
+  const [busyId, setBusyId] = useState<string | null>(null);
+  const [actionError, setActionError] = useState<string | null>(null);
+  const [declining, setDeclining] = useState<TimeOffRequest | null>(null);
+  const [reason, setReason] = useState('');
+  const [reasonError, setReasonError] = useState<string | undefined>();
+
+  useEffect(() => {
+    let cancelled = false;
+    getTimeOffRequests().then(
+      (data) => !cancelled && setRequests(data),
+      (error: unknown) => !cancelled && setLoadError(error instanceof Error ? error.message : 'Could not load requests'),
+    );
+    return () => {
+      cancelled = true;
+    };
+  }, []);
+
+  const filtered = useMemo(
+    () =>
+      (requests ?? [])
+        .filter((request) => (status === ALL || request.status === status) && (type === ALL || request.type === type))
+        .sort((a, b) => a.start.localeCompare(b.start)),
+    [requests, status, type],
+  );
+
+  const pendingCount = requests?.filter((request) => request.status === 'pending').length ?? 0;
+
+  function replace(updated: TimeOffRequest) {
+    setRequests((current) => current?.map((item) => (item.id === updated.id ? updated : item)) ?? current);
+  }
+
+  async function approve(request: TimeOffRequest) {
+    setBusyId(request.id);
+    setActionError(null);
+    try {
+      replace(await approveRequest(request.id));
+    } catch (error) {
+      setActionError(error instanceof Error ? error.message : 'Could not approve the request');
+    } finally {
+      setBusyId(null);
+    }
+  }
+
+  function openDecline(request: TimeOffRequest) {
+    setDeclining(request);
+    setReason('');
+    setReasonError(undefined);
+  }
+
+  async function submitDecline(event: FormEvent) {
+    event.preventDefault();
+    if (!declining) return;
+    if (!reason.trim()) {
+      setReasonError('Add a reason so the employee knows why.');
+      return;
+    }
+    setBusyId(declining.id);
+    setActionError(null);
+    try {
+      replace(await declineRequest(declining.id, reason));
+      setDeclining(null);
+    } catch (error) {
+      setReasonError(error instanceof Error ? error.message : 'Could not decline the request');
+    } finally {
+      setBusyId(null);
+    }
+  }
+
+  const decliningStaff = declining ? staff.find((member) => member.id === declining.staffId) : undefined;
+
+  return (
+    <>
+      <PageHeader
+        title="Time off"
+        description={requests ? `${pendingCount} ${pendingCount === 1 ? 'request' : 'requests'} awaiting review` : 'Review staff time-off requests'}
+      />
+
+      <div className={styles.filters}>
+        <Select id="timeoff-status" label="Status" value={status} options={statusOptions} onChange={(event) => setStatus(event.target.value)} />
+        <Select id="timeoff-type" label="Type" value={type} options={typeOptions} onChange={(event) => setType(event.target.value)} />
+      </div>
+
+      {actionError ? (
+        <p className={styles.error} role="alert">
+          {actionError}
+        </p>
+      ) : null}
+
+      <Card flush>
+        {loadError ? (
+          <EmptyState title="Could not load requests" description={loadError} />
+        ) : requests === null ? (
+          <Skeleton height="12rem" />
+        ) : filtered.length === 0 ? (
+          <EmptyState
+            title={status === 'pending' ? 'No requests to review' : 'No requests match these filters'}
+            description={status === 'pending' ? 'You are all caught up.' : 'Try a different status or type.'}
+          />
+        ) : (
+          <Table>
+            <TableHead>
+              <TableRow>
+                <TableHeaderCell>Employee</TableHeaderCell>
+                <TableHeaderCell>Dates</TableHeaderCell>
+                <TableHeaderCell>Type</TableHeaderCell>
+                <TableHeaderCell>Note</TableHeaderCell>
+                <TableHeaderCell>Status</TableHeaderCell>
+                <TableHeaderCell aria-label="Actions" />
+              </TableRow>
+            </TableHead>
+            <TableBody>
+              {filtered.map((request) => {
+                const member = staff.find((item) => item.id === request.staffId);
+                const days = countDays(request);
+                return (
+                  <TableRow key={request.id}>
+                    <TableCell>
+                      <p className={styles.name}>{member?.name ?? 'Unknown staff'}</p>
+                      <p className={styles.sub}>{member?.role}</p>
+                    </TableCell>
+                    <TableCell>
+                      <p>{formatRange(request)}</p>
+                      <p className={styles.sub}>{days === 1 ? '1 day' : `${days} days`}</p>
+                    </TableCell>
+                    <TableCell>{typeLabels[request.type]}</TableCell>
+                    <TableCell>
+                      <p className={styles.note}>{request.note || 'No note'}</p>
+                    </TableCell>
+                    <TableCell>
+                      <Badge tone={statusTones[request.status]}>{request.status[0].toUpperCase() + request.status.slice(1)}</Badge>
+                    </TableCell>
+                    <TableCell>
+                      {request.status === 'pending' ? (
+                        <div className={styles.actions}>
+                          <Button size="sm" variant="primary" loading={busyId === request.id && !declining} disabled={busyId !== null} onClick={() => approve(request)}>
+                            Approve
+                          </Button>
+                          <Button size="sm" variant="secondary" disabled={busyId !== null} onClick={() => openDecline(request)}>
+                            Decline
+                          </Button>
+                        </div>
+                      ) : null}
+                    </TableCell>
+                  </TableRow>
+                );
+              })}
+            </TableBody>
+          </Table>
+        )}
+      </Card>
+
+      <Modal
+        open={declining !== null}
+        title="Decline time-off request"
+        onClose={() => setDeclining(null)}
+        footer={
+          <>
+            <Button variant="ghost" onClick={() => setDeclining(null)}>
+              Cancel
+            </Button>
+            <Button variant="danger" type="submit" form="decline-form" loading={busyId !== null && declining !== null}>
+              Decline request
+            </Button>
+          </>
+        }
+      >
+        {declining ? (
+          <form id="decline-form" onSubmit={submitDecline} noValidate>
+            <p className={styles.summary}>
+              {decliningStaff?.name}, {typeLabels[declining.type].toLowerCase()}, {formatRange(declining)}
+            </p>
+            <Textarea
+              id="decline-reason"
+              label="Reason"
+              hint="Shared with the employee."
+              value={reason}
+              error={reasonError}
+              onChange={(event) => {
+                setReason(event.target.value);
+                setReasonError(undefined);
+              }}
+            />
+          </form>
+        ) : null}
+      </Modal>
+    </>
+  );
+}
