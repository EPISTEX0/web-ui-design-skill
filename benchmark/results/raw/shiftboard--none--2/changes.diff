diff --git a/src/pages/TimeOff.tsx b/src/pages/TimeOff.tsx
new file mode 100644
index 0000000..b806166
--- /dev/null
+++ b/src/pages/TimeOff.tsx
@@ -0,0 +1,245 @@
+import { useCallback, useEffect, useMemo, useState } from 'react';
+import { Badge, Button, Card, EmptyState, Modal, PageHeader, Select, Skeleton, Table, TableBody, TableCell, TableHead, TableHeaderCell, TableRow, Textarea } from '../components';
+import type { BadgeTone } from '../components';
+import { approveRequest, declineRequest, getTimeOffRequests } from '../api/timeOff';
+import type { TimeOffRequest, TimeOffStatus, TimeOffType } from '../api/timeOff';
+import { locations } from '../data/locations';
+import { staff } from '../data/staff';
+import styles from './TimeOff.module.css';
+
+type StatusFilter = TimeOffStatus | 'all';
+
+const statusOptions: { value: StatusFilter; label: string }[] = [
+  { value: 'pending', label: 'Pending' },
+  { value: 'approved', label: 'Approved' },
+  { value: 'declined', label: 'Declined' },
+  { value: 'all', label: 'All requests' },
+];
+
+const statusTone: Record<TimeOffStatus, BadgeTone> = { pending: 'warning', approved: 'success', declined: 'danger' };
+const typeLabel: Record<TimeOffType, string> = { vacation: 'Vacation', sick: 'Sick leave', personal: 'Personal' };
+
+const dateFormat = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
+
+function parseDate(value: string): Date {
+  const [year, month, day] = value.split('-').map(Number);
+  return new Date(year, month - 1, day);
+}
+
+function formatRange(start: string, end: string): string {
+  return start === end ? dateFormat.format(parseDate(start)) : `${dateFormat.format(parseDate(start))} to ${dateFormat.format(parseDate(end))}`;
+}
+
+function countDays(start: string, end: string): number {
+  return Math.round((parseDate(end).getTime() - parseDate(start).getTime()) / 86_400_000) + 1;
+}
+
+function errorMessage(error: unknown): string {
+  return error instanceof Error ? error.message : 'Something went wrong. Please try again.';
+}
+
+export function TimeOff() {
+  const [requests, setRequests] = useState<TimeOffRequest[] | null>(null);
+  const [loadError, setLoadError] = useState<string | null>(null);
+  const [filter, setFilter] = useState<StatusFilter>('pending');
+  const [busyId, setBusyId] = useState<string | null>(null);
+  const [actionError, setActionError] = useState<string | null>(null);
+  const [declining, setDeclining] = useState<TimeOffRequest | null>(null);
+  const [reason, setReason] = useState('');
+  const [reasonError, setReasonError] = useState<string | undefined>();
+
+  const load = useCallback(() => {
+    setLoadError(null);
+    getTimeOffRequests().then(setRequests, (error) => setLoadError(errorMessage(error)));
+  }, []);
+
+  useEffect(load, [load]);
+
+  const pendingCount = requests?.filter((item) => item.status === 'pending').length ?? 0;
+
+  const visible = useMemo(() => {
+    const list = (requests ?? []).filter((item) => filter === 'all' || item.status === filter);
+    // Pending: oldest first so the longest-waiting requests surface first. Others: most recent first.
+    return list.sort((a, b) => (filter === 'pending' ? a.createdAt.localeCompare(b.createdAt) : b.createdAt.localeCompare(a.createdAt)));
+  }, [requests, filter]);
+
+  function replace(next: TimeOffRequest) {
+    setRequests((current) => current?.map((item) => (item.id === next.id ? next : item)) ?? null);
+  }
+
+  async function approve(request: TimeOffRequest) {
+    setBusyId(request.id);
+    setActionError(null);
+    try {
+      replace(await approveRequest(request.id));
+    } catch (error) {
+      setActionError(errorMessage(error));
+    } finally {
+      setBusyId(null);
+    }
+  }
+
+  function openDecline(request: TimeOffRequest) {
+    setDeclining(request);
+    setReason('');
+    setReasonError(undefined);
+  }
+
+  function closeDecline() {
+    if (busyId) return;
+    setDeclining(null);
+  }
+
+  async function confirmDecline() {
+    if (!declining) return;
+    if (!reason.trim()) {
+      setReasonError('Enter a reason so the employee knows why.');
+      return;
+    }
+    setBusyId(declining.id);
+    setActionError(null);
+    try {
+      replace(await declineRequest(declining.id, reason.trim()));
+      setDeclining(null);
+    } catch (error) {
+      setReasonError(errorMessage(error));
+    } finally {
+      setBusyId(null);
+    }
+  }
+
+  const decliningMember = declining ? staff.find((member) => member.id === declining.staffId) : undefined;
+
+  return (
+    <>
+      <PageHeader
+        title="Time off"
+        description={requests ? `${pendingCount} ${pendingCount === 1 ? 'request' : 'requests'} awaiting review` : 'Review staff time-off requests'}
+      />
+
+      <div className={styles.filters}>
+        <Select id="timeoff-status" label="Status" value={filter} options={statusOptions} onChange={(event) => setFilter(event.target.value as StatusFilter)} />
+      </div>
+
+      {actionError ? (
+        <p className={styles.error} role="alert">
+          {actionError}
+        </p>
+      ) : null}
+
+      <Card flush>
+        {loadError ? (
+          <EmptyState
+            icon="clock"
+            title="Couldn't load time-off requests"
+            description={loadError}
+            action={
+              <Button variant="secondary" size="sm" onClick={load}>
+                Try again
+              </Button>
+            }
+          />
+        ) : requests === null ? (
+          <div className={styles.skeletons} role="status" aria-label="Loading time-off requests">
+            <Skeleton height={20} />
+            <Skeleton height={20} />
+            <Skeleton height={20} />
+            <Skeleton height={20} />
+          </div>
+        ) : visible.length === 0 ? (
+          <EmptyState
+            icon="check"
+            title={filter === 'pending' ? 'All caught up' : 'No requests to show'}
+            description={filter === 'pending' ? 'There are no pending time-off requests.' : 'No requests match this status.'}
+          />
+        ) : (
+          <Table>
+            <TableHead>
+              <TableRow>
+                <TableHeaderCell>Employee</TableHeaderCell>
+                <TableHeaderCell>Type</TableHeaderCell>
+                <TableHeaderCell>Dates</TableHeaderCell>
+                <TableHeaderCell>Note</TableHeaderCell>
+                <TableHeaderCell>Status</TableHeaderCell>
+                <TableHeaderCell numeric>Actions</TableHeaderCell>
+              </TableRow>
+            </TableHead>
+            <TableBody>
+              {visible.map((request) => {
+                const member = staff.find((item) => item.id === request.staffId);
+                const location = locations.find((item) => item.id === member?.locationId);
+                const days = countDays(request.start, request.end);
+                const busy = busyId === request.id;
+                return (
+                  <TableRow key={request.id}>
+                    <TableCell>
+                      <p className={styles.name}>{member?.name ?? 'Unknown employee'}</p>
+                      <p className={styles.sub}>{[member?.role, location?.name].filter(Boolean).join(' · ')}</p>
+                    </TableCell>
+                    <TableCell>{typeLabel[request.type]}</TableCell>
+                    <TableCell>
+                      <p>{formatRange(request.start, request.end)}</p>
+                      <p className={styles.sub}>{days} {days === 1 ? 'day' : 'days'}</p>
+                    </TableCell>
+                    <TableCell>
+                      <p className={styles.note}>{request.note || '—'}</p>
+                    </TableCell>
+                    <TableCell>
+                      <Badge tone={statusTone[request.status]}>{request.status[0].toUpperCase() + request.status.slice(1)}</Badge>
+                    </TableCell>
+                    <TableCell numeric>
+                      {request.status === 'pending' ? (
+                        <div className={styles.actions}>
+                          <Button size="sm" variant="primary" loading={busy} disabled={busyId !== null} onClick={() => approve(request)} aria-label={`Approve request from ${member?.name ?? 'employee'}`}>
+                            Approve
+                          </Button>
+                          <Button size="sm" variant="secondary" disabled={busyId !== null} onClick={() => openDecline(request)} aria-label={`Decline request from ${member?.name ?? 'employee'}`}>
+                            Decline
+                          </Button>
+                        </div>
+                      ) : null}
+                    </TableCell>
+                  </TableRow>
+                );
+              })}
+            </TableBody>
+          </Table>
+        )}
+      </Card>
+
+      <Modal
+        open={declining !== null}
+        title="Decline time off"
+        onClose={closeDecline}
+        footer={
+          <>
+            <Button variant="secondary" onClick={closeDecline} disabled={busyId !== null}>
+              Cancel
+            </Button>
+            <Button variant="danger" onClick={confirmDecline} loading={busyId !== null}>
+              Decline request
+            </Button>
+          </>
+        }
+      >
+        {declining ? (
+          <>
+            <p className={styles.summary}>
+              {decliningMember?.name ?? 'This employee'} · {typeLabel[declining.type]} · {formatRange(declining.start, declining.end)}
+            </p>
+            <Textarea
+              id="timeoff-reason"
+              label="Reason for declining"
+              value={reason}
+              error={reasonError}
+              onChange={(event) => {
+                setReason(event.target.value);
+                setReasonError(undefined);
+              }}
+            />
+          </>
+        ) : null}
+      </Modal>
+    </>
+  );
+}
