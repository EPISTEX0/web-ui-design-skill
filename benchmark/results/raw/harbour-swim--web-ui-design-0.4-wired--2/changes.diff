+  tr {
+    display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s2) var(--s3);
+    background: var(--color-surface); border: 1px solid var(--color-border); border-left: 4px solid var(--yellow-500);
+    border-radius: var(--radius); padding: var(--s4);
+  }
+  td, tbody tr:nth-child(even) td { display: block; padding: 0; border: 0; background: none; }
+  td:nth-child(3) { grid-column: 1 / -1; grid-row: 1; font-size: 1.1875rem; line-height: 1.25; }
+  td:nth-child(1) { grid-column: 1 / 2; grid-row: 2; color: var(--color-text-muted); }
+  td:nth-child(2) { grid-column: 2 / -1; grid-row: 2; font-weight: 600; }
+  td:nth-child(n+4) { grid-row: 3; padding-top: var(--s2); border-top: 1px solid var(--color-border); font-size: 0.9375rem; }
+  td:nth-child(n+4)::before { display: block; font-size: 0.8125rem; color: var(--color-text-muted); }
+  td:nth-child(4)::before { content: "Lane"; }
