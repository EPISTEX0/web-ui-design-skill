diff --git a/src/lib/dates.ts b/src/lib/dates.ts
index 602941c..0abd4ee 100644
--- a/src/lib/dates.ts
+++ b/src/lib/dates.ts
@@ -31,3 +31,19 @@ export function shiftHours(start: string, end: string): number {
   if (endMinutes <= startMinutes) endMinutes += 24 * 60;
   return (endMinutes - startMinutes) / 60;
 }
+
+const rangeFormat = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
+
+function parseIsoDate(value: string): Date {
+  const [year, month, day] = value.split('-').map(Number);
+  return new Date(year, month - 1, day);
+}
+
+export function formatDateRange(start: string, end: string): string {
+  if (start === end) return rangeFormat.format(parseIsoDate(start));
+  return `${rangeFormat.format(parseIsoDate(start))} to ${rangeFormat.format(parseIsoDate(end))}`;
+}
+
+export function countDays(start: string, end: string): number {
+  return Math.round((parseIsoDate(end).getTime() - parseIsoDate(start).getTime()) / 86400000) + 1;
+}
